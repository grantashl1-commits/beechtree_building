# Copy to .env.local for local dev (`npm run dev` serves /api with these).
# On Vercel: Project → Settings → Environment Variables. Never commit real values.

# ── Google reviews (Places API New) ─────────────────────────────────────────
# Google Cloud console → enable "Places API (New)" → create an API key,
# restricted to that API. Find the Place ID with Google's Place ID Finder.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Optional: only show reviews at or above this star rating (default 4)
REVIEWS_MIN_RATING=4
# Optional: where "Read all reviews" points (defaults to the Google Maps listing)
GOOGLE_REVIEWS_URL=

# ── Optional: every review, newest first (Google Business Profile API) ──────
# Takes priority over Places when all five are set. See docs/HANDOVER.md.
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_ACCOUNT_ID=
GBP_LOCATION_ID=

# ── Contact form (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=simon@beechtreebuilding.co.nz
# Must be on a domain verified in Resend (onboarding@resend.dev works for testing)
CONTACT_FROM_EMAIL=Beechtree Website <website@beechtreebuilding.co.nz>
