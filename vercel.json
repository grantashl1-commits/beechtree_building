{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "redirects": [
    { "source": "/the-bridge-house", "destination": "/projects/the-bridge-house", "permanent": true },
    { "source": "/kinloch-retreat", "destination": "/projects/kinloch-retreat", "permanent": true },
    { "source": "/hawk-ridge", "destination": "/projects/hawk-ridge", "permanent": true },
    { "source": "/wild-at-heart", "destination": "/projects/wild-at-heart", "permanent": true },
    { "source": "/oak-leaf-abode", "destination": "/projects/oak-leaf-abode", "permanent": true },
    { "source": "/whareroa-hideaway", "destination": "/projects/whareroa-hideaway", "permanent": true },
    { "source": "/the-boathouse", "destination": "/projects/the-boathouse", "permanent": true },
    { "source": "/curved-by-the-course", "destination": "/projects/curved-by-the-course", "permanent": true },
    { "source": "/clad-to-meet-you", "destination": "/projects/clad-to-meet-you", "permanent": true },
    { "source": "/skandi-by-the-lake", "destination": "/projects/skandi-by-the-lake", "permanent": true },
    { "source": "/two-in-one", "destination": "/projects/two-in-one", "permanent": true },
    { "source": "/testimonials", "destination": "/#reviews", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
